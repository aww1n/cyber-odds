# Runtime
APP_ENV=production
LOG_LEVEL=INFO
POSTGRES_PASSWORD=replace_with_a_long_random_password
REDIS_URL=redis://redis:6379/0
RAW_DATA_DIR=/app/data/raw

# Telegram (no real bets are placed; this bot only publishes research signals)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=
# TELEGRAM_ALERT_CHAT_ID=-1001234567890
TELEGRAM_PUBLISH_INTERVAL_SECONDS=2

# Fonbet odds collector: set the verified line host explicitly
FONBET_ENABLED=true
FONBET_BASE_URL=
FONBET_SCOPE_MARKET=1600
FONBET_LANGUAGE=ru
ODDS_COLLECTION_INTERVAL_SECONDS=60

# Historical sources
UEL_ENABLED=false
UEL_BASE_URL=https://api.unitedleagues.gg
UEL_SPORT=efootball
UEL_SOURCE_TIMEZONE=Europe/Moscow
SIS_H2H_ENABLED=false
SIS_H2H_BASE_URL=https://api-h2h.hudstats.com
SIS_H2H_SPORT=fifa
SIS_H2H_SOURCE_TIMEZONE=Europe/Moscow
ESB_ENABLED=false
ESB_BASE_URL=https://football.esportsbattle.com
HISTORY_COLLECTION_INTERVAL_SECONDS=300
HISTORY_MAX_TOURNAMENTS=5
SETTLEMENT_INTERVAL_SECONDS=10

# Risk display and alert timing
BANKROLL=100000
DEFAULT_STAKE_PERCENT=1.5
MIN_STAKE_PERCENT=0.25
MAX_STAKE_PERCENT=3.0
ALERT_MINUTES_BEFORE_START=10

# Leakage-safe corridor materialization
CORRIDOR_REBUILD_INTERVAL_SECONDS=300
CORRIDOR_MAX_ODDS_AGE_MINUTES=15
CORRIDOR_BUCKET_WIDTH=0.25
CORRIDOR_MIN_SAMPLES=20
